# L2gether Environment Variables

# Backend server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
# Set DATABASE_URL to use PostgreSQL (e.g. postgresql://user:password@localhost:5432/l2gether)
# If left empty, L2gether automatically uses high-performance embedded SQLite database for zero-config local dev!
DATABASE_URL=

# Session secret for guest signing
SESSION_SECRET=l2gether-dev-secret-super-secure-key-32chars

# File Storage
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=25

# Code Execution Service
EXECUTION_TIMEOUT_MS=10000
MAX_OUTPUT_BUFFER_BYTES=65536

# Room Retention Policy
ROOM_EXPIRY_DAYS=7
CLEANUP_INTERVAL_MINUTES=30
