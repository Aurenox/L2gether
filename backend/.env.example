# L2gether Backend Environment Variables

PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# Database configuration:
# PostgreSQL URL (e.g. from Render PostgreSQL, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
# If DATABASE_URL is not set, L2gether automatically uses native SQLite storage!
DATABASE_URL=

SESSION_SECRET=your-secure-random-32-character-secret

UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=25

EXECUTION_TIMEOUT_MS=10000
MAX_OUTPUT_BUFFER_BYTES=65536

ROOM_EXPIRY_DAYS=7
CLEANUP_INTERVAL_MINUTES=30
